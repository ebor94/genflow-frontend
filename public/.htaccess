# GenFlow SPA — Vue 3 + Vite bajo /genflow/
# Se copia automáticamente a dist/.htaccess en cada `npm run build` (Vite
# publica public/ tal cual). Antes vivía sólo en el server y un rsync
# --delete lo borraba silenciosamente; ahora es fuente-única en el repo.
Options -MultiViews
RewriteEngine On
RewriteBase /genflow/

# Assets existentes se sirven tal cual; el resto va a index.html
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

# Service worker: nunca cachear (para que updates se propaguen)
<Files "sw.js">
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header set Pragma "no-cache"
  Header set Expires "0"
</Files>

# Assets con hash (Vite les pone -HASH.js/.css): cache largo, inmutable
<FilesMatch "\.(js|css|woff2|png|jpg|svg|ico)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# index.html: no cachear
<Files "index.html">
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
</Files>
